local movingStates = {Forward = false, Up = false, Backward = false, Down = false}
btnForward.MouseButton1Down:Connect(function() movingStates.Forward = true end)
btnForward.MouseButton1Up:Connect(function() movingStates.Forward = false end)
btnUp.MouseButton1Down:Connect(function() movingStates.Up = true end)
