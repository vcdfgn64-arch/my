-- ==========================================================
-- ระบบรันลูปโจมตี 0.1s + ดึงไอเทมช่อง 3 อัตโนมัติ
-- ==========================================================
task.spawn(function()
    while true do
        if autoAttackEnabled then
            pcall(function()
                local char = LocalPlayer.Character
                local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                
                -- ดึงดาบไม้มาถือหากอยู่ในกระเป๋า
                if char and not char:FindFirstChild("Wooden Sword") then
                    if backpack then
                        local swordInPack = backpack:FindFirstChild("Wooden Sword")
                        if swordInPack then
                            swordInPack.Parent = char
                        end
                    end
                end

                -- จำลองกดปุ่มเลข 3 เพื่อสลับช่องไอเทม
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
                task.wait(0.02)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)

                -- ยิง Event โจมตีรัวๆ
                local sword = char and char:FindFirstChild("Wooden Sword")
                if sword then
                    local args = { sword }
                    ReplicatedStorage:WaitForChild("Events"):WaitForChild("SwordHitEvent"):FireServer(unpack(args))
                end
            end)
        end
        task.wait(0.1)
    end
end)
