-- Shadow Hex X สร้างเรือ (22 Min Timeout & Auto Restart Loop Version)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local player = Players.LocalPlayer

if player.PlayerGui:FindFirstChild("ShadowHexBoatGui") then
    player.PlayerGui.ShadowHexBoatGui:Destroy()
end
if player.PlayerGui:FindFirstChild("ShadowHexBlackScreen") then
    player.PlayerGui.ShadowHexBlackScreen:Destroy()
end

local originalVolume = 0.5
pcall(function()
    if SoundService and SoundService.Volume then
        originalVolume = SoundService.Volume
    end
end)

local waypoints = {
    Vector3.new(454.66, -9.90, 293.57),
    Vector3.new(-55.59, 55.16, 350.02),
    Vector3.new(-37.31, 78.59, 8806.67),
    Vector3.new(-48.78, -219.91, 8803.70),
    Vector3.new(-57.16, -315.52, 9495.87)
}

local travelSpeed = 999 
local isRunning = false
local isAutoLoop = false

print("Shadow Hex X Loaded Successfully!")

local runSequence

local function flyToTarget(targetPos)
    local character = player.Character
    if not character then return false end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if humanoidRootPart and humanoid then
        humanoid.PlatformStand = true
        humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        
        local currentPos = humanoidRootPart.Position
        local distance = (targetPos - currentPos).Magnitude
        local timeTaken = distance / travelSpeed
        
        if timeTaken < 0.05 then timeTaken = 0.05 end
        
        local tweenInfo = TweenInfo.new(timeTaken, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
        local tween = TweenService:Create(humanoidRootPart, tweenInfo, {CFrame = CFrame.new(targetPos)})
        tween:Play()
        
        local elapsed = 0
        local timeoutLimit = 1320 -- 22 นาที (22 * 60 = 1320 วินาที)
        
        while elapsed < timeTaken do
            if not isRunning then return false end
            
            -- ถ้าเกิน 22 นาทีแล้วยังไปไม่ถึง สั่งรีเซ็ตตัวละครทันที
            if elapsed >= timeoutLimit then
                humanoid.PlatformStand = false
                if humanoid and humanoid.Health > 0 then
                    humanoid.Health = 0
                end
                return false
            end
            
            task.wait(1)
            elapsed = elapsed + 1
        end
        
        humanoid.PlatformStand = false
        return true
    end
    return false
end

