local function enableBlackScreen()
    pcall(function()
        if SoundService and SoundService.Volume then
            originalVolume = SoundService.Volume
            SoundService.Volume = 0
        end
    end)
    blackScreenGui.Enabled = true
end

local function disableBlackScreen()
    pcall(function()
        if SoundService and SoundService.Volume then
            SoundService.Volume = originalVolume
        end
    end)
    blackScreenGui.Enabled = false
end

runSequence = function(isAuto)
    if isRunning then return end
    isRunning = true
    isAutoLoop = isAuto
    
    actionButton.BackgroundColor3 = Color3.fromRGB(88, 28, 135)
    
    task.spawn(function()
        while isRunning do
            for i = 1, #waypoints - 1 do
                if not isRunning then break end
                actionButton.Text = tostring(i)
                local success = flyToTarget(waypoints[i])
                if not success then break end
                task.wait(0.2)
            end
            
            if not isRunning then break end
            
            actionButton.Text = "5"
            local success = flyToTarget(waypoints[#waypoints])
            if not success then break end
            
            for sec = 17, 1, -1 do
                if not isRunning then break end
                actionButton.Text = tostring(sec)
                task.wait(1)
            end
            
            if not isRunning then break end
            
            if isAutoLoop then
                actionButton.Text = "🔄"
                task.wait(0.5)
            else
                actionButton.Text = "✔"
                actionButton.BackgroundColor3 = Color3.fromRGB(18, 16, 26)
                isRunning = false
                break
            end
        end
        
        if not isRunning and not isAutoLoop then
            actionButton.Text = "🚢"
            actionButton.BackgroundColor3 = Color3.fromRGB(18, 16, 26)
        end
    end)
end

-- เมื่อตัวละครเกิดใหม่ หากเปิดโหมดออโต้ไว้ จะทำการเริ่มรันลูปใหม่อัตโนมัติทันที
player.CharacterAdded:Connect(function(newChar)
    task.wait(2) -- รอโหลดตัวละครใหม่
    if isAutoLoop then
        isRunning = false
        runSequence(true)
    end
end)

actionButton.MouseButton1Click:Connect(function()
    if isRunning then
        isRunning = false
        isAutoLoop = false
        actionButton.Text = "🚢"
        actionButton.BackgroundColor3 = Color3.fromRGB(18, 16, 26)
    else
        runSequence(false)
    end
end)

cancelBlackButton.MouseButton1Click:Connect(function()
    disableBlackScreen()
end)

player.Chatted:Connect(function(message)
    local msg = message:lower()
    if msg == "afk go" then
        if not isRunning then runSequence(true) end
    elseif msg == "afk stop" then
        isRunning = false
        isAutoLoop = false
        actionButton.Text = "🚢"
        actionButton.BackgroundColor3 = Color3.fromRGB(18, 16, 26)
    elseif msg == "หน้าจอดำ" then
        enableBlackScreen()
    elseif msg == "หยุดหน้าจอดำ" then
        disableBlackScreen()
    end
end)
