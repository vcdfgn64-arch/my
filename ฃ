-- ==================== ระบบการทำงานทั้งหมด ====================
local running1 = false
local running2 = false
local running3 = false

local rs = game:GetService("ReplicatedStorage")
local vim = game:GetService("VirtualInputManager")
local vu = game:GetService("VirtualUser")

-- ปุ่มที่ 1 Logic
toggleBtn1.MouseButton1Click:Connect(function()
	running1 = not running1
	if running1 then
		toggleBtn1.Text = "Pullup: ON"
		toggleBtn1.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
	else
		toggleBtn1.Text = "Pullup: OFF"
		toggleBtn1.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	end
end)

task.spawn(function()
	while true do
		if running1 then
			local speed = tonumber(speedBox1.Text) or 0.1
			pcall(function()
				rs:WaitForChild("PullupEvent"):FireServer()
			end)
			task.wait(speed)
		else
			task.wait(0.1)
		end
	end
end)

-- ปุ่มที่ 2 Logic
toggleBtn2.MouseButton1Click:Connect(function()
	running2 = not running2
	if running2 then
		toggleBtn2.Text = "OnM1: ON"
		toggleBtn2.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
	else
		toggleBtn2.Text = "OnM1: OFF"
		toggleBtn2.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	end
end)

task.spawn(function()
	while true do
		if running2 then
			local speed = tonumber(speedBox2.Text) or 0.1
			pcall(function()
				rs:WaitForChild("RunTime"):WaitForChild("OnM1Event"):FireServer()
			end)
			task.wait(speed)
		else
			task.wait(0.1)
		end
	end
end)

-- ระบบ Anti-AFK หลักป้องกันหลุด 20 นาที
player.Idled:Connect(function()
	if running3 then
		pcall(function()
			vu:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
			task.wait(1)
			vu:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
		end)
	end
end)

-- ปุ่มที่ 3 Logic (No AFK: แตะกลางจอ 1 ครั้ง ทุกๆ นาทีที่กำหนด)
toggleBtn3.MouseButton1Click:Connect(function()
	running3 = not running3
	if running3 then
		toggleBtn3.Text = "No AFK: ON"
		toggleBtn3.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
	else
		toggleBtn3.Text = "No AFK: OFF"
		toggleBtn3.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	end
end)

task.spawn(function()
	while true do
		if running3 then
			local waitMinutes = tonumber(minuteBox.Text) or 5
			
			pcall(function()
				local viewportSize = workspace.CurrentCamera.ViewportSize
				local centerX = viewportSize.X / 2
				local centerY = viewportSize.Y / 2
				
				if vim then
					vim:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
					task.wait(0.05)
					vim:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)
				end
			end)
			
			local totalWaitSeconds = waitMinutes * 60
			local elapsed = 0
			while elapsed < totalWaitSeconds and running3 do
				task.wait(1)
				elapsed = elapsed + 1
			end
		else
			task.wait(0.5)
		end
	end
end)
