-- ระบบดักจับคำสั่งในแชท
player.Chatted:Connect(function(message)
    local msg = message:lower()
    
    if msg == "afk go" then
        if not isRunning then
            runSequence(true)
        end
    elseif msg == "afk stop" then
        isRunning = false
        actionButton.Text = "🚢"
        actionButton.BackgroundColor3 = Color3.fromRGB(18, 16, 26)
        
    -- คำสั่งเปิด/ปิดหน้าจอดำผ่านแชท
    elseif msg == "หน้าจอดำ" then
        enableBlackScreen()
    elseif msg == "หยุดหน้าจอดำ" then
        disableBlackScreen()
    end
end)
