-- ฟังก์ชันเปิดหน้าจอดำ (ปิดเสียง)
local function enableBlackScreen()
    originalVolume = SoundService.Volume -- บันทึกเสียงปัจจุบันไว้ก่อน
    SoundService.Volume = 0             -- ปิดเสียงเป็น 0
    blackScreenGui.Enabled = true
end

-- ฟังก์ชันปิดหน้าจอดำ (คืนค่าเสียงเดิม)
local function disableBlackScreen()
    SoundService.Volume = originalVolume -- คืนค่าเสียงเดิม
    blackScreenGui.Enabled = false
end

-- ฟังก์ชันการทำงานหลัก
local function runSequence(isAuto)
    if isRunning then return end
    isRunning = true
    isAutoLoop = isAuto
    
    actionButton.BackgroundColor3 = Color3.fromRGB(88, 28, 135)
    
    task.spawn(function()
        while isRunning do
            -- วิ่ง 1 ถึง 4
            for i = 1, #waypoints - 1 do
                if not isRunning then break end
                actionButton.Text = i
                local success = flyToTarget(waypoints[i])
                if not success then break end
                task.wait(0.2)
            end
            
            if not isRunning then break end
            
            -- จุดที่ 5 (สุดท้าย)
            actionButton.Text = "5"
            local success = flyToTarget(waypoints[#waypoints])
            if not success then break end
            
            -- ถึงจุดที่ 5: รอ 17 วินาที
            for sec = 17, 1, -1 do
                if not isRunning then break end
                actionButton.Text = sec
                task.wait(1)
            end
            
            if not isRunning then break end
            
            -- เงื่อนไขวนลูป
            if isAutoLoop then
                actionButton.Text = "🔄"
                task.wait(0.5)
            else
                actionButton.Text = "✔"
                actionButton.BackgroundColor3 = Color3.fromRGB(18, 16, 26)
                isRunning = false
                break
            end
        end
        
        if not isRunning and not isAutoLoop then
            actionButton.Text = "🚢"
            actionButton.BackgroundColor3 = Color3.fromRGB(18, 16, 26)
        end
    end)
end

-- กดปุ่ม (Manual Mode)
