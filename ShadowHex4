flingActionBtn.MouseButton1Click:Connect(function()
    if not selectedTargetName then return end
    local targetPlayer = Players:FindFirstChild(selectedTargetName)
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = localPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") and myChar:FindFirstChild("Humanoid") then
            local myHrp = myChar.HumanoidRootPart
            local myHumanoid = myChar.Humanoid
            local originalPos = myHrp.CFrame
            myHumanoid.PlatformStand = true
            for _, p in pairs(myChar:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
            local connection
            local angle = 0
            connection = RunService.Heartbeat:Connect(function()
                pcall(function()
                    if targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local tHrp = targetPlayer.Character.HumanoidRootPart
                        angle = angle + targetFlingSpeed
                        myHrp.CFrame = tHrp.CFrame * CFrame.new(0, -1, 0) * CFrame.Angles(0, math.rad(angle), 0)
                        myHrp.AssemblyLinearVelocity = Vector3.new(targetFlingSpeed, 99999, targetFlingSpeed)
                        myHrp.AssemblyAngularVelocity = Vector3.new(99999, 99999, 99999)
                    end
                end)
            end)
            task.delay(10, function()
                if connection then connection:Disconnect() end
                pcall(function()
                    myHumanoid.PlatformStand = false
                    myHrp.CFrame = originalPos
                    myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    myHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
