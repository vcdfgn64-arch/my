RunService.RenderStepped:Connect(function()
    pcall(function()
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= localPlayer then
                if not espDrawings[p] then
                    pcall(function()
                        if Drawing then
                            espDrawings[p] = { Box = Drawing.new("Square"), Name = Drawing.new("Text"), Tracer = Drawing.new("Line") }
                            espDrawings[p].Box.Filled = false
                            espDrawings[p].Box.Thickness = 1.5
                            espDrawings[p].Name.Size = 14
                            espDrawings[p].Name.Center = true
                            espDrawings[p].Name.Outline = true
                            espDrawings[p].Tracer.Thickness = 1.5
                        end
                    end)
                end
                local drawings = espDrawings[p]
                if drawings and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Head") then
                    local hrp = p.Character.HumanoidRootPart
                    local head = p.Character.Head
                    local vector, onScreen = camera:WorldToViewportPoint(hrp.Position)
                    if onScreen and (espSettings.Name or espSettings.Distance or espSettings.Box or espSettings.Tracer) then
                        local headVec = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local legVec = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        local height = math.abs(headVec.Y - legVec.Y)
                        local width = height / 2

                        if espSettings.Box and drawings.Box then
                            drawings.Box.Visible = true
                            drawings.Box.Size = Vector2.new(width, height)
                            drawings.Box.Position = Vector2.new(vector.X - width / 2, headVec.Y)
                            drawings.Box.Color = currentThemeColor
                        elseif drawings.Box then drawings.Box.Visible = false end

                        if (espSettings.Name or espSettings.Distance) and drawings.Name then
                            drawings.Name.Visible = true
                            local textDisplay = ""
                            if espSettings.Name then textDisplay = p.Name end
                            if espSettings.Distance and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                local dist = math.floor((localPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)
                                textDisplay = textDisplay .. " [" .. dist .. "m]"
                            end
                            drawings.Name.Text = textDisplay
                            drawings.Name.Position = Vector2.new(vector.X, headVec.Y - 18)
                            drawings.Name.Color = Color3.fromRGB(255, 255, 255)
                        elseif drawings.Name then drawings.Name.Visible = false end

                        if espSettings.Tracer and drawings.Tracer then
                            drawings.Tracer.Visible = true
                            drawings.Tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                            drawings.Tracer.To = Vector2.new(vector.X, legVec.Y)
                            drawings.Tracer.Color = currentThemeColor
                        elseif drawings.Tracer then drawings.Tracer.Visible = false end
                    else
                        if drawings.Box then drawings.Box.Visible = false end
                        if drawings.Name then drawings.Name.Visible = false end
                        if drawings.Tracer then drawings.Tracer.Visible = false end
                    end
                end
            end
        end
    end)
end)

Players.PlayerRemoving:Connect(function(p)
