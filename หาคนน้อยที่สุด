-- [กระบวนการทำงานหลัก]
task.spawn(function()
    -- 1. สร้างและรันหน้าจอโหลด 1-100% ก่อน
    local loadingGui, percentLabel, barFill = createLoadingUI()
    
    for i = 1, 100 do
        percentLabel.Text = "กำลังโหลดระบบ Shadow Hex... " .. i .. "%"
        barFill.Size = UDim2.new(i / 100, 0, 1, 0)
        task.wait(0.015) -- ความเร็วในการวิ่งของหลอด (ปรับเร็วช้าตรงนี้ได้)
    end
    
    task.wait(0.3)
    loadingGui:Destroy() -- ลบหน้าจอโหลดทิ้งเมื่อครบ 100%

    -- 2. เปิดหน้าจอหลักและเริ่มระบบ Server Hopper
    local ui, statusLabel, cancelBtn = createShadowHexUI()

    cancelBtn.MouseButton1Click:Connect(function()
        isRunning = false
        statusLabel.Text = "กำลังปิดระบบ Shadow Hex..."
        task.wait(0.5)
        if ui then ui:Destroy() end
    end)

    local cursor = ""
    while isRunning do
        pagesChecked = pagesChecked + 1
        statusLabel.Text = "กำลังหาเซิร์ฟเวอร์คนน้อย...\nเปิดไปแล้ว: " .. pagesChecked .. " หน้า"
        
        local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then
            url = url .. "&cursor=" .. cursor
        end
        
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        if success and result and result.data then
            local targetServer = nil
            local minPlayers = math.huge
            
            for _, server in ipairs(result.data) do
                if server.playing < minPlayers and server.id ~= game.JobId then
                    if server.playing < server.maxPlayers then
                        minPlayers = server.playing
                        targetServer = server.id
                    end
                end
            end
            
            -- เจอหน้าไหนมีคนน้อยกว่าหรือเท่ากับ 3 คน วาปทันที
            if targetServer and minPlayers <= 3 then
                statusLabel.Text = "✅ เจอเซิร์ฟเวอร์คนน้อย ("..minPlayers.." คน)\nเปิดไปทั้งหมด " .. pagesChecked .. " หน้า กำลังวาป..."
                task.wait(0.5)
                TeleportService:TeleportToPlaceInstance(PlaceId, targetServer, LocalPlayer)
                isRunning = false
                break
            end
            
            if result.nextPageCursor then
                cursor = result.nextPageCursor
                task.wait(0.8)
            else
                cursor = ""
                task.wait(1)
            end
        else
            statusLabel.Text = "⚠️ เกิดข้อผิดพลาด\nไม่สามารถดึงข้อมูลเซิร์ฟเวอร์ได้"
            isRunning = false
            task.wait(3)
            if ui then ui:Destroy() end
        end
    end
end)
