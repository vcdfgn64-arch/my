espToggleContainer.Size = UDim2.new(1, 0, 0, 40)
espToggleContainer.BackgroundTransparency = 1
espToggleContainer.Parent = espPage
local espToggleText = createLabel(espToggleContainer, "เปิด/ปิด แสดงตำแหน่งผู้เล่น (ESP)")
espToggleText.Size = UDim2.new(0, 180, 1, 0)
local espBtn = Instance.new("TextButton")
espBtn.Size = UDim2.new(0, 60, 0, 28)
espBtn.Position = UDim2.new(1, -60, 0.5, -14)
espBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
espBtn.Text = "OFF"
espBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
espBtn.TextSize, espBtn.Font = 12, Enum.Font.GothamBold
espBtn.Parent = espToggleContainer
Instance.new("UICorner", espBtn).CornerRadius = UDim.new(1, 0)

local espEnabled = false
espBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    espBtn.Text = espEnabled and "ON" or "OFF"
    espBtn.BackgroundColor3 = espEnabled and currentThemeColor or Color3.fromRGB(40, 40, 40)
end)

RunService.RenderStepped:Connect(function()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = p.Character.HumanoidRootPart
            local highlight = hrp:FindFirstChild("ShadowHex_ESP")
            if espEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "ShadowHex_ESP"
                    highlight.Adornee = p.Character
                    highlight.FillColor = currentThemeColor
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.Parent = hrp
                end
            else
                if highlight then highlight:Destroy() end
            end
        end
    end
end)

