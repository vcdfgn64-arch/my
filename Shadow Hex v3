local function createSliderBg(parent)
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 0, 8)
    bg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    bg.BackgroundTransparency = 0.3
    bg.BorderSizePixel = 0
    bg.Parent = parent
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)
    return bg
end

local function createSliderFill(parent, size)
    local fill = Instance.new("Frame")
    fill.Size = size
    fill.BackgroundColor3 = currentThemeColor
    fill.BorderSizePixel = 0
    fill.Parent = parent
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    table.insert(sliderFillsList, fill)
    return fill
end

local function applySlider(bg, fill, minVal, maxVal, callback)
    local dragging = false
    bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local pos = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
            fill.Size = UDim2.new(pos, 0, 1, 0)
            callback(math.floor(minVal + (maxVal - minVal) * pos))
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local pos = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
            fill.Size = UDim2.new(pos, 0, 1, 0)
            callback(math.floor(minVal + (maxVal - minVal) * pos))
        end
    end)
end
